<?xml version="1.0" encoding="UTF-8"?>
<teamcity-plugin>
    <info>
        <name>kensa-teamcity-plugin</name>
        <display-name>Kensa Integration</display-name>
        <version>0.1.0</version>
        <description>Surfaces Kensa BDD test reports inside TeamCity: per-build report tab, first-class test results, Given-When-Then failure summaries.</description>
